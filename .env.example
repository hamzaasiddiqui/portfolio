# Copy to .env.local for local development. Never commit .env.local.

# --- Required by the app (build time AND runtime) --------------------------
# The page is prerendered at build time and reads content from Supabase, so
# both of these must also be set on Vercel (Project Settings → Environment
# Variables → Production) or the build fails with "supabaseUrl is required".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# --- Local tooling only (never needed on Vercel) ---------------------------
# `pnpm seed` — writes content over PostgREST, bypassing RLS. Server-only;
# must never be prefixed NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# `supabase db push --db-url` / `supabase gen types --db-url` — direct
# Postgres connection string.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# --- Vercel only -----------------------------------------------------------
# Any random string. Vercel sends it as a bearer token with the daily cron
# that hits /api/keep-alive; the route rejects requests without it.
CRON_SECRET=<random string>
